   if(month)rows=rows.filter(r=>r.mes===month);
 }
 const title=`Tickets · ${dim==='mes'?'Periodo':FIL[dim]||dim} = ${dim==='mes'?mlabel(val):val}${month?' · '+mlabel(month):''} (${rows.length} tickets · ${new Set(rows.map(r=>r.id)).size} sitios)`;
 showModal(title,rows);
}
function showModal(title,rows){
 const headers=['Ticket Id','Site ID','Region','Periodo','Estatus','Tipo MP','Tipo local','FM Office / Zona','RM','Supervisor','Proveedor','Plan','Real','Rech','Lev','A tiempo'];
 let h=`<table><thead><tr>${headers.map(x=>`<th>${x}</th>`).join('')}</tr></thead><tbody>`;
 rows.forEach(r=>{
   h+=`<tr><td>${esc(r.tid||'')}</td><td>${esc(r.id)}</td><td>${r.region}</td><td>${mlabel(r.mes)}</td><td>${esc(r.st)}</td><td>${r.mp}</td><td>${r.local}</td><td>${esc(r.fm)}</td><td>${esc(r.rm)}</td><td>${esc(r.sp)}</td><td>${esc(r.prov)}</td><td>${r.plan}</td><td>${r.real}</td><td>${r.rech}</td><td>${r.lev}</td><td>${r.ot===null?'–':r.ot}</td></tr>`;
 });
 h+='</tbody></table>';
 $('mtitle').textContent=title;
 $('mbody').innerHTML=h;
 $('modal').classList.add('on');
}
function closeModal(){$('modal').classList.remove('on')}
document.addEventListener('keydown',e=>{if(e.key==='Escape')closeModal()});

// --- EXPORTACIÓN A EXCEL ---
function exportExcel(){
 if(!T.length){alert('Carga datos primero');return}
 const rows=data();
 if(!rows.length){alert('No hay datos con los filtros actuales');return}
 const unit=UNIT;
 const meses=[...new Set(rows.map(r=>r.mes))].sort();
 const sts=[...new Set(rows.map(r=>r.st))].sort();
 const regions=[...new Set(rows.map(r=>r.region))].sort();
 const header=['Region','Periodo','Planificados','Realizados','Rechazados','Levantados','Rechazos pendientes','% Avance','% Rechazo','% Levantamiento','% A tiempo',...sts];
 const aoa=[header];
 const rowFor=(region,mes,rs)=>{
   const x=agg(rs,unit);
   return [region, mes==='TOTAL'?'TOTAL':mlabel(mes), x.plan, x.real, x.rech, x.lev, x.pend, x.cum, x.rr, x.lr, x.ontime, ...sts.map(s=>cnt(rs.filter(r=>r.st===s)))];
 };
 regions.forEach(reg=>{
   const regRows=rows.filter(r=>r.region===reg);
   aoa.push(rowFor(reg,'TOTAL',regRows));
   const byMonth=by(regRows,'mes');
   meses.forEach(m=>{ if(byMonth[m]) aoa.push(rowFor(reg,m,byMonth[m])); });
 });
 aoa.push(rowFor('TOTAL GENERAL','TOTAL',rows));
 const ws=XLSX.utils.aoa_to_sheet(aoa);
 const wb=XLSX.utils.book_new();
 XLSX.utils.book_append_sheet(wb,ws,'Resumen_Region_Periodo');
 // Hoja plana agregada (por región+mes)
 const flatAoa=[header];
 regions.forEach(reg=>{
   const byMonth=by(rows.filter(r=>r.region===reg),'mes');
   meses.forEach(m=>{ if(byMonth[m]) flatAoa.push(rowFor(reg,m,byMonth[m])); });
 });
 XLSX.utils.book_append_sheet(wb,XLSX.utils.aoa_to_sheet(flatAoa),'Datos_Agregados');
 // Hoja de tickets (detalle para tabla dinámica)
 const tHeader=['Ticket Id','Site ID','Region','Periodo','Estatus','Tipo MP','Tipo local','FM Office / Zona','RM','Supervisor','Proveedor','Plan','Real','Rech','Lev','A tiempo','Cancelado'];
 const tAoa=[tHeader];
 rows.forEach(r=>{
   tAoa.push([r.tid||'', r.id, r.region, mlabel(r.mes), r.st, r.mp, r.local, r.fm, r.rm, r.sp, r.prov, r.plan, r.real, r.rech, r.lev, r.ot===null?'':r.ot, r.canc?1:0]);
 });
 XLSX.utils.book_append_sheet(wb,XLSX.utils.aoa_to_sheet(tAoa),'Tickets');
 {const zs=zoneStats(),za=[['Mes',mlabel(ZMON)],[],['Grupo','RM','Zona','Completados','Pendientes','Total (target)','Avance %']];zs.rows.forEach(o=>za.push([o.g,o.rm,o.z,o.d,Math.max(0,o.t-o.d),o.t,o.t?o.a:'']));const td=zs.rows.reduce((a,o)=>a+o.d,0),tt=zs.rows.reduce((a,o)=>a+o.t,0);za.push(['TOTAL','','',td,zs.rows.reduce((a,o)=>a+Math.max(0,o.t-o.d),0),tt,tt?Math.round(td/tt*1000)/10:'']);XLSX.utils.book_append_sheet(wb,XLSX.utils.aoa_to_sheet(za),'Avance_Zona')}
 XLSX.writeFile(wb,'Reporte_MP_Region_Periodo.xlsx');
}

// --- AVANCE POR ZONA (target mensual) ---
const ZT0=[['LIMA NORTE',120],['LIMA OESTE',120],['LIMA ESTE',120],['LIMA SUR',120],['TINGO MARIA',6],['HUANUCO',30],['PUCALLPA',20],['YURIMAGUAS',3],['IQUITOS',12],['TARAPOTO',30],['CERRO DE PASCO',5],['HUANCAYO',30],['SATIPO',5],['HUANCAVELICA',5],['TARMA',5],['LA MERCED',6],['AYACUCHO',20],['ICA',30],['VRAEM',5]],
 GRP={'CARLOS OCAÑA':'LIMA Norte y Oeste','ERNESTO ROJAS':'LIMA Este y Sur','EDUARDO NEYRA':'CENTRO 1','PERCY RODRIGUEZ':'CENTRO 2'};
let ZT={},ZMON='';try{ZT=JSON.parse(localStorage.getItem('pm_zt_v1')||'{}')||{}}catch(e){ZT={}}
const tgt=z=>ZT[z]!==undefined?ZT[z]:((ZT0.find(x=>x[0]===z)||[0,0])[1]);
function dataZ(){const g=k=>$('f_'+k).value,nc=$('nc').checked,ncp=$('ncp')&&$('ncp').checked,nge=$('nge')&&$('nge').checked;
 return T.filter(r=>r.d&&(!nc||!r.canc)&&(!ncp||!r.ncp)&&(!nge||r.mp!=='Grupo electrógeno')&&Object.keys(FIL).every(k=>!g(k)||r[k]===g(k)))}
function zoneStats(){const dz=dataZ(),months=[...new Set(dz.map(r=>r.d.slice(0,7)))].sort();if(!months.includes(ZMON))ZMON=months[months.length-1]||'';
 const S={};dz.forEach(r=>{if(r.d.slice(0,7)!==ZMON||!r.isdone)return;(S[r.fm]||(S[r.fm]=new Set)).add(r.id)});
 const known=ZT0.map(x=>x[0]),extra=[...new Set(dz.map(r=>r.fm))].filter(z=>z&&!known.includes(z)).sort(),
  rmOf=z=>{const e=(typeof REF!=='undefined'?REF:[]).find(x=>x[6]===z&&x[1]==='Aplica');return e&&e[2]||''};
 const rows=[...known,...extra].map(z=>{const rm=rmOf(z),d=S[z]?S[z].size:0,tg=tgt(z);return{z,rm,g:GRP[rm]||rm||'Otras zonas',d,t:tg,a:tg?Math.round(d/tg*1000)/10:0}});
 return{months,rows}}
function renderZone(){if(!$('zt'))return;const zs=zoneStats(),R=zs.rows;
 $('zm').innerHTML=zs.months.map(m=>`<option value="${m}" ${m===ZMON?'selected':''}>${mlabel(m)}</option>`).join('')||'<option>–</option>';
 const td=R.reduce((a,o)=>a+o.d,0),tt=R.reduce((a,o)=>a+o.t,0),tp=R.reduce((a,o)=>a+Math.max(0,o.t-o.d),0);
 let h='<table><thead><tr><th style="text-align:left">Grupo · RM</th><th style="text-align:left">Zona</th><th>Compl.</th><th>Pend.</th><th>Target</th><th>Avance</th></tr></thead><tbody>';
 R.forEach((o,i)=>{const first=i===0||R[i-1].g!==o.g||R[i-1].rm!==o.rm;let n=1;if(first)while(R[i+n]&&R[i+n].g===o.g&&R[i+n].rm===o.rm)n++;
  h+=`<tr>${first?`<td rowspan="${n}" class="zg"><b>${esc(o.g)}</b>${o.rm&&o.rm!==o.g?`<br><span class="sub">${esc(o.rm)}</span>`:''}</td>`:''}<td class="zl">${esc(o.z)}</td><td>${o.d}</td><td>${Math.max(0,o.t-o.d)}</td><td><input type="number" min="0" value="${o.t}" data-z="${esc(o.z)}" onchange="PM.setTarget(this.dataset.z,this.value)"></td><td style="font-weight:600;color:${o.t?col(o.a):'inherit'}">${o.t?o.a+'%':'–'}</td></tr>`});
 h+=`</tbody><tfoot><tr><td colspan="2" style="text-align:left">TOTAL</td><td>${td}</td><td>${tp}</td><td>${tt}</td><td>${tt?Math.round(td/tt*1000)/10:0}%</td></tr></tfoot></table>`;
 $('zt').innerHTML=h;
 CH.zc&&CH.zc.destroy();const RC=R.filter(o=>o.t>0);$('zcw').style.height=Math.max(260,RC.length*22+70)+'px';
 const ad=RC.map(o=>Math.min(100,100*o.d/o.t)),pe=ad.map(v=>100-v);
 CH.zc=new Chart($('zc'),{type:'bar',data:{labels:RC.map(o=>o.z),datasets:[
  {label:'Completados',data:ad,backgroundColor:'#2fa36b',datalabels:{display:true,anchor:'end',align:x=>ad[x.dataIndex]>=78?'start':'end',clamp:true,offset:4,color:'#fff',font:{size:11,weight:'700'},textStrokeColor:'rgba(0,0,0,.6)',textStrokeWidth:3,formatter:(v,x)=>{const o=RC[x.dataIndex];return Math.round(100*o.d/o.t)+'%  ('+o.d+'/'+o.t+')'}}},
  {label:'Pendientes',data:pe,backgroundColor:'rgba(154,165,184,.2)',borderColor:'rgba(154,165,184,.4)',borderWidth:1,datalabels:{display:false}}]},
  options:{indexAxis:'y',maintainAspectRatio:false,layout:{padding:{right:8}},interaction:{mode:'index',intersect:false},datasets:{bar:{barPercentage:.78,categoryPercentage:.95}},plugins:{legend:{position:'top'},tooltip:{callbacks:{footer:i=>{const o=RC[i[0].dataIndex];return o.d+' de '+o.t+' sitios'}}}},scales:{x:{stacked:true,min:0,max:100,ticks:{stepSize:20,callback:v=>v+'%'}},y:{stacked:true,ticks:{font:{size:11}}}}}})}
function setZM(v){ZMON=v;renderZone()}
function setTarget(z,v){ZT[z]=Math.max(0,Math.round(+v)||0);try{localStorage.setItem('pm_zt_v1',JSON.stringify(ZT))}catch(e){}renderZone()}
function resetTargets(){ZT={};try{localStorage.removeItem('pm_zt_v1')}catch(e){}renderZone()}
function setScale(s){PS=s;T.forEach(r=>{r.mes=pkey(r.d,PS)});['D','W','M','Q'].forEach(k=>{const b=$('sc_'+k);if(b)b.className=k===s?'on':''});render()}
function setData(rows,name){T0=rows;PSUB=(name?name+' · ':'')+rows.length+' tickets PM';build(true)}
window.PM={render,build,setUnit,setScale,setZM,setTarget,resetTargets,exportExcel,closeModal,setData,setDim:v=>{dim=v;render()},setT1m:v=>{t1m=v;render()},rebuild:()=>{if(T0.length)build()}};

})();
</script></body></html>
